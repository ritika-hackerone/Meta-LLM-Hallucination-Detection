# ─────────────────────────────────────────────────────────────
#  Meta-LLM Hallucination Detector — Environment Variables
#  Copy this file to .env and fill in your values.
#
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Gemini API (required) ─────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier: gemini-2.5-flash → 10 RPM / 250 requests per day
GEMINI_API_KEY=your-gemini-api-key-here

# ── RAG Settings (optional — defaults shown) ──────────────────
RAG_TOP_K=5
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── NLI Settings (optional — defaults shown) ──────────────────
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_CONTRADICTION_THRESHOLD=0.6
NLI_ENTAILMENT_THRESHOLD=0.6

# ── Verdict Labels (do not change) ────────────────────────────
LABEL_CORRECT=CORRECT
LABEL_HALLUCINATED=HALLUCINATED
LABEL_UNCERTAIN=UNCERTAIN


# # ── LLM API Keys ──────────────────────────────────────────────
# # Get your Anthropic key at: https://console.anthropic.com/
# # Add Gemini

# # Optional: OpenAI fallback
# # OPENAI_API_KEY=sk-your-openai-key-here

# # ── RAG Configuration ─────────────────────────────────────────
# # Max Wikipedia paragraphs to retrieve per query
# RAG_TOP_K=5

# # ── NLI Configuration ─────────────────────────────────────────
# # HuggingFace NLI model (auto-downloaded on first run)
# # Options: cross-encoder/nli-deberta-v3-base (best)
# #          typeform/distilbert-base-uncased-mnli (faster)
# NLI_MODEL=cross-encoder/nli-deberta-v3-base

# # ── Thresholds ────────────────────────────────────────────────
# ENTAILMENT_THRESHOLD=0.6
# CONTRADICTION_THRESHOLD=0.6
